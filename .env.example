POSTGRES_DB=barrel23
POSTGRES_USER=barrel23
POSTGRES_PASSWORD=your-db-password-here

DATABASE_URL=postgresql://barrel23:your-db-password-here@db:5432/barrel23
SECRET_KEY=your-long-random-secret-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-here

# Default mailbox shown in the admin for every signed-in browser.
# Use a Purelymail app password if MFA is enabled. Never commit real values.
MAIL_DEFAULT_DISPLAY_NAME=BARREL 23
MAIL_DEFAULT_EMAIL=info@barrel23.com
MAIL_DEFAULT_PASSWORD=your-purelymail-app-password
MAIL_DEFAULT_IMAP_HOST=imap.purelymail.com
MAIL_DEFAULT_IMAP_PORT=993
MAIL_DEFAULT_IMAP_SECURITY=ssl_tls
MAIL_DEFAULT_SMTP_HOST=smtp.purelymail.com
MAIL_DEFAULT_SMTP_PORT=465
MAIL_DEFAULT_SMTP_SECURITY=ssl_tls

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required to save additional mailboxes through the admin.
MAIL_CREDENTIALS_KEY=your-fernet-key
MAIL_MAX_ATTACHMENT_MB=20
